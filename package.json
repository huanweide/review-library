{
  "name": "review-library",
  "version": "1.5.2",
  "author": "retri",
  "repository": "https://github.com/huanweide/review-library",
  "private": true,
  "description": "统一复习资料项目：导入 PDF/PPT/Word/图片 → 建一本书 → 大模型整本整体分析 → 可层层展开的思维导图 + 题型分类索引。桌面端 / HTTP / DSH 插件 / 专家形态共用同一 core/。",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node server.js",
    "pretest": "node scripts/sync-versions.mjs && node scripts/check-versions.mjs && node scripts/check-forms.mjs",
    "test": "node scripts/run-tests.js",
    "test:e2e": "node _e2e/e2e.js",
    "versions:sync": "node scripts/sync-versions.mjs",
    "versions:check": "node scripts/check-versions.mjs",
    "forms:sync": "node scripts/sync-engine.mjs",
    "forms:check": "node scripts/check-forms.mjs",
    "build:dir": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "cn.sirui.reviewlibrary",
    "productName": "ReviewLibrary",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "core/**/*",
      "lib/**/*",
      "renderer/**/*",
      "server.js",
      "package.json",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-updater/out/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/jszip/**/*",
      "node_modules/temp/**/*",
      "node_modules/tough-cookie/**/*",
      "node_modules/immer/**/*",
      "node_modules/pdf-parse/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "ReviewLibrary-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "ReviewLibrary-${version}-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "huanweide",
        "repo": "review-library"
      }
    ],
    "asar": true,
    "buildVersion": "1.5.2",
    "extraMetadata": {
      "main": "app/main.js"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright-core": "^1.64.1"
  }
}
